rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isTechnician() {
      return request.auth != null
        && request.auth.token.role == 'technician';
    }
    function isHostOf(sessionId) {
      return request.auth != null
        && request.auth.token.role == 'host_session'
        && request.auth.token.sessionId == sessionId;
    }

    match /sessions/{id} {
      allow read: if true;
      allow create: if isTechnician();
      allow update: if isTechnician() || isHostOf(id);
      allow delete: if false;
    }

    match /comments/{id} {
      allow read: if true;
      allow create: if false;   // only via Cloud Function
      allow update: if isHostOf(resource.data.sessionId);
      allow delete: if false;
    }

    match /calls/{id} {
      allow read: if true;
      allow create: if false;   // only via Cloud Function
      allow update: if isTechnician() || isHostOf(resource.data.sessionId);
      allow delete: if false;
    }

    match /radios/{id} {
      allow read: if true;
      allow write: if isTechnician() || request.auth.token.role == 'radio_admin';
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
